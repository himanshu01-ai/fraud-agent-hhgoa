CREATE GRAPH FraudGraph()
USE GRAPH FraudGraph
CREATE SCHEMA_CHANGE JOB fraud_schema FOR GRAPH FraudGraph {
  ADD VERTEX Customer (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Card (PRIMARY_ID id STRING, customer_id STRING, network STRING, card_type STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Txn (PRIMARY_ID id STRING, ts DATETIME, amt DOUBLE, product STRING, channel STRING,
                  addr1 STRING, addr2 STRING, p_email STRING, r_email STRING, risk_score DOUBLE, p_model DOUBLE,
                  id_15 STRING, id_23 STRING, m4 STRING, m6 STRING, card_id STRING, customer_id STRING,
                  device STRING, uid STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX DeviceProfile (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX EmailDomain (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX BillingRegion (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Cardholder (PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at DATETIME,
                         closed_at DATETIME, outcome STRING, pattern STRING, first_fraud_txn_id STRING,
                         txn_ids STRING, n_txns INT, exposure_usd DOUBLE, connected_card_ids STRING,
                         actions_taken STRING, report_filed STRING, analyst_notes STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX InvestigationCase (PRIMARY_ID id STRING, case_id STRING, opened_at DATETIME, trigger_type STRING,
                         status STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING,
                         pattern_description STRING, exposure_usd DOUBLE, sar_filed BOOL,
                         final_actions STRING, summary STRING, answer_json STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";

  ADD UNDIRECTED EDGE OWNS (FROM Customer, TO Card);
  ADD UNDIRECTED EDGE MADE (FROM Card, TO Txn);
  ADD UNDIRECTED EDGE FROM_DEVICE (FROM Txn, TO DeviceProfile);
  ADD UNDIRECTED EDGE PURCHASER_EMAIL (FROM Txn, TO EmailDomain);
  ADD UNDIRECTED EDGE BILLED_IN (FROM Txn, TO BillingRegion);
  ADD UNDIRECTED EDGE BEHAVES_AS (FROM Txn, TO Cardholder);
  ADD UNDIRECTED EDGE INVOLVES (FROM ClosedCase, TO Txn);
  ADD UNDIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);
  ADD UNDIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);
  ADD UNDIRECTED EDGE INV_ON_CARD (FROM InvestigationCase, TO Card);
  ADD UNDIRECTED EDGE INV_AFFECTS (FROM InvestigationCase, TO Txn);
  ADD UNDIRECTED EDGE INV_CONNECTED (FROM InvestigationCase, TO Card);
  ADD UNDIRECTED EDGE INV_DEVICE (FROM InvestigationCase, TO DeviceProfile);
  ADD UNDIRECTED EDGE INV_SIMILAR (FROM InvestigationCase, TO ClosedCase);
}
RUN SCHEMA_CHANGE JOB fraud_schema
DROP JOB fraud_schema
