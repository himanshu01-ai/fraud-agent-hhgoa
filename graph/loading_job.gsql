USE GRAPH FraudGraph
CREATE LOADING JOB load_txn FOR GRAPH FraudGraph {
  DEFINE FILENAME f_txn;
  LOAD f_txn
    TO VERTEX Txn VALUES ($"TransactionID", $"ts", $"TransactionAmt", $"ProductCD", $"channel", $"addr1", $"addr2",
                          $"P_emaildomain", $"R_emaildomain", $"risk_score", $"p_model", $"id_15", $"id_23",
                          $"M4", $"M6", $"card_id", $"customer_id", $"device_profile", $"uid"),
    TO VERTEX Customer VALUES ($"customer_id"),
    TO VERTEX Card VALUES ($"card_id", $"customer_id", $"card4", $"card6"),
    TO EDGE OWNS VALUES ($"customer_id", $"card_id"),
    TO EDGE MADE VALUES ($"card_id", $"TransactionID"),
    TO VERTEX DeviceProfile VALUES ($"device_profile") WHERE $"device_profile" != "",
    TO EDGE FROM_DEVICE VALUES ($"TransactionID", $"device_profile") WHERE $"device_profile" != "",
    TO VERTEX EmailDomain VALUES ($"P_emaildomain") WHERE $"P_emaildomain" != "",
    TO EDGE PURCHASER_EMAIL VALUES ($"TransactionID", $"P_emaildomain") WHERE $"P_emaildomain" != "",
    TO VERTEX BillingRegion VALUES ($"addr1") WHERE $"addr1" != "",
    TO EDGE BILLED_IN VALUES ($"TransactionID", $"addr1") WHERE $"addr1" != "",
    TO VERTEX Cardholder VALUES ($"uid") WHERE $"uid" != "",
    TO EDGE BEHAVES_AS VALUES ($"TransactionID", $"uid") WHERE $"uid" != ""
    USING SEPARATOR=",", HEADER="true", EOL="\n", QUOTE="double";
}
CREATE LOADING JOB load_cases FOR GRAPH FraudGraph {
  DEFINE FILENAME f_cc;
  DEFINE FILENAME f_cc_txn;
  DEFINE FILENAME f_cc_conn;
  LOAD f_cc
    TO VERTEX ClosedCase VALUES ($"case_id", $"customer_id", $"card_id", $"opened_at", $"closed_at", $"outcome",
                                 $"pattern", $"first_fraud_txn_id", $"txn_ids", $"n_txns", $"exposure_usd",
                                 $"connected_card_ids", $"actions_taken", $"report_filed", $"analyst_notes"),
    TO EDGE ON_CARD VALUES ($"case_id", $"card_id")
    USING SEPARATOR=",", HEADER="true", EOL="\n", QUOTE="double";
  LOAD f_cc_txn TO EDGE INVOLVES VALUES ($"case_id", $"txn_id")
    USING SEPARATOR=",", HEADER="true", EOL="\n";
  LOAD f_cc_conn TO EDGE CONNECTED_TO VALUES ($"case_id", $"card_id")
    USING SEPARATOR=",", HEADER="true", EOL="\n";
}
